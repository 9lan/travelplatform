              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if(jsonData.access_token){",
                  "    console.log(`jsonData.access_token : ${jsonData.access_token}`)",
                  "    pm.environment.set(\"TRAVELOKA_TOKEN\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
