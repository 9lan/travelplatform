                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"bookingContact\": {\n    \"salutation\": \"Mr\",\n    \"firstName\": \"Jet Lieee\",\n    \"lastName\": \"Jet Lieee\",\n    \"email\": \"jetlie233@gmail.com\",\n    \"phoneNumber\": {\n      \"countryCode\": \"62\",\n      \"phoneNumber\": \"082288015711\"\n    }\n  },\n  \"departBookings\": [\n    {\n      \"routeId\": \"114059\",\n      \"skuId\": \"8838\",\n      \"providerId\": \"PTEKASARILORENA\",\n      \"providerName\": \"LORENA\",\n      \"pickUpPointCode\": \"p2\",\n      \"dropOffPointCode\": \"p67\",\n      \"busTripCode\": \"LS-420\",\n      \"seatClass\": \"Super Executive\",\n      \"seatSubclass\": \"Penumpang\",\n      \"specificDepartDateTime\": {\n        \"specificDate\": {\n          \"monthDayYear\": {\n            \"month\": 1,\n            \"day\": 2025,\n            \"year\": 18\n          },\n          \"hourMinute\": {\n            \"hour\": 13,\n            \"minute\": 0\n          }\n        },\n        \"timeZoneId\": \"Asia/Jakarta\"\n      },\n      \"specificArrivalDateTime\": {\n        \"specificDate\": {\n          \"monthDayYear\": {\n            \"month\": 1,\n            \"day\": 2025,\n            \"year\": 19\n          },\n          \"hourMinute\": {\n            \"hour\": 3,\n            \"minute\": 15\n          }\n        },\n        \"timeZoneId\": \"Asia/Jakarta\"\n      },\n      \"adultPassengers\": [\n        {\n          \"salutation\": \"Mr\",\n          \"firstName\": \"Jet Lieee\",\n          \"lastName\": \"Jet Lieee\",\n          \"wagonId\": \"-\",\n          \"seatNumber\": \"2F\",\n          \"passengerIdentity\": {\n            \"idType\": \"KTP\",\n            \"value\": \"1234567890123456\"\n          }\n        }\n      ]\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{TRAVELOKA_URL_API}}/bus/booking",
                  "host": [
                    "{{TRAVELOKA_URL_API}}"
                  ],
                  "path": [
                    "bus",
                    "booking"
                  ]
                },
                "description": "To book a bus as requested by customers.\n\n- Set the return date for round trip\n    \n- Always check the price given in the booking response, as there might some cases that the price given in the search result is no longer valid. You should notify the customer if this happens before proceeding to the payment process.\n    \n- Validate that no passengers in one booking has the same exact name.\n    \n- Validate that no passenger name contains any special character.\n    \n- Validate the mobile phone number length is 10 digits at minimum.(the phone number country code without “+” e.g: 62)\n    \n- Ideally, maximum characters for each firstName and lastName are 20 characters and the minimum for each is 2 characters.\n    \n- If you get timeout response during booking API request call, try to call booking status API to check whether the booking has successfully been made.\n    \n- Pax 2 years and above must buy a ticket.\n    \n- The maximum number of adults in one booking is 4 pax."
              },
              "response": [
                {
                  "name": "Booking",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "{{TRAVELOKA_TOKEN}}"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n    \"bookingContact\": {\n        \"salutation\": \"MR\",\n        \"firstName\": \"John\",\n        \"lastName\": \"Doe\",\n        \"email\": \"john.doe@email.com\",\n        \"phoneNumber\": {\n            \"countryCode\": \"62\",\n            \"phoneNumber\": \"81323456789\"\n        }\n    },\n    \"departBookings\": [\n        {\n            \"pickUpPointCode\": \"p1\",\n            \"dropOffPointCode\": \"p2\",\n            \"routeId\": \"54425\",\n            \"skuId\": \"123\",\n            \"busTripCode\": \"PK-402\",\n            \"providerId\": \"PTPahalaKencana\",\n            \"specificDepartDateTime\": {\n                \"specificDate\": {\n                    \"monthDayYear\": {\n                        \"month\": 1,\n                        \"day\": 1,\n                        \"year\": 2019\n                    },\n                    \"hourMinute\": {\n                        \"hour\": 13,\n                        \"minute\": 45\n                    }\n                },\n                \"timeZoneId\": \"Asia/Jakarta\"\n            },\n            \"specificArrivalDateTime\": {\n                \"specificDate\": {\n                    \"monthDayYear\": {\n                        \"month\": 1,\n                        \"day\": 1,\n                        \"year\": 2019\n                    },\n                    \"hourMinute\": {\n                        \"hour\": 13,\n                        \"minute\": 45\n                    }\n                },\n                \"timeZoneId\": \"Asia/Jakarta\"\n            },\n            \"seatClass\": \"Executive\",\n            \"seatSubclass\": \"A\",\n            \"adultPassengers\": [\n                {\n                    \"salutation\": \"MR\",\n                    \"firstName\": \"John\",\n                    \"lastName\": \"Doe\",\n                    \"passengerIdentity\": {\n                        \"idType\": \"KTP\",\n                        \"value\": \"1231