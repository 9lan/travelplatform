            {
              "name": "Check Booking",
              "request": {
                "auth": {
                  "type": "apikey"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{TRAVELOKA_TOKEN}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"travelokaBookingId\": 101546753\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{TRAVELOKA_URL_API}}/bus/check-booking",
                  "host": [
                    "{{TRAVELOKA_URL_API}}"
                  ],
                  "path": [
                    "bus",
                    "check-booking"
                  ]
                },
                "description": "1. To check the booking status as requested by customers.\n    \n2. Booking status definition:\n    \n\n- BOOKED: the booking has successfully confirmed but the respective e-ticket is not yet issued.\n    \n- ISSUED: the payment for the respective booking has been verified and the e-ticket has been issued.\n    \n- CANCELLED: the booking expiration time (from Traveloka to provider) of the respective booking has already been exceeded, and thus the booking is cancelled.\n    \n- FAILED: status when there is a system distruption"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Issuance",
          "item": [
            {
              "name": "Issue Booking",
              "request": {
                "auth": {
                  "type": "apikey"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "{{TRAVELOKA_TOKEN}}",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"travelokaBookingId\": 1184826609,\n  \"paymentMethod\": \"NON_CREDIT_CARD\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{TRAVELOKA_URL_API}}/bus/issue-booking",
                  "host": [
                    "{{TRAVELOKA_URL_API}}"
                  ],
                  "path": [
                    "bus",
                    "issue-booking"
                  ]
                },
                "description": "1. To issue the booking as requested by customers.\n    \n2. The ticket number (if not null) needs to be printed as a qrcode on eticket.  \n    Status:\n    \n\n- OK: Your booking ID successfully issued.\n    \n- PAYMENT_CONFIRMED: Your booking ID confirmed payment but still process to issue.\n    \n- FAILED: There was an error when issuing your booking, please try to contact us.\n    \n- ALREADY_ISSUED: Your booking ID was already issued.\n    \n- ALREADY_CANCELLED: Your booking ID was already cancelled/expired.\n    \n- INVALID_AFFILIATE: Your booking ID is not yours.\n    \n- BOOKING_NOT_FOUND: Your booking ID is not found."
              },
              "response": []
            }
          ]
        }
      ]
