generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Price {
  id         String   @id @default(cuid())
  scheduleId String
  routeId    String
  basePrice  Float
  currency   String   @default("IDR")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scheduleId])
  @@index([routeId])
  @@index([isActive])
}

model PriceRule {
  id            String        @id @default(cuid())
  name          String
  description   String?
  ruleType      PriceRuleType
  routeId       String?       // null means applies to all routes
  conditions    Json          // JSON conditions for when rule applies
  adjustment    Float         // percentage or fixed amount
  adjustmentType AdjustmentType
  priority      Int           @default(0)
  isActive      Boolean       @default(true)
  validFrom     DateTime?
  validTo       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ruleType])
  @@index([routeId])
  @@index([isActive])
  @@index([priority])
}

model SeatTypePrice {
  id         String   @id @default(cuid())
  routeId    String?  // null means applies to all routes
  seatType   String   // REGULAR, PREMIUM, VIP
  multiplier Float    @default(1.0) // price multiplier
  fixedExtra Float    @default(0) // fixed additional amount
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([routeId, seatType])
  @@index([seatType])
  @@index([isActive])
}

enum PriceRuleType {
  SURGE           // Occupancy-based surge pricing
  TIME_BASED      // Time of day pricing
  DAY_OF_WEEK     // Day-based pricing
  ADVANCE_BOOKING // Early booking discount
  HOLIDAY         // Holiday pricing
  PROMOTIONAL     // Promotional pricing
}

enum AdjustmentType {
  PERCENTAGE
  FIXED
}
